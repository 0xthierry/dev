export ZDOTDIR="${HOME}/.config/zsh"

[[ -f "${ZDOTDIR}/path.sh" ]] && source "${ZDOTDIR}/path.sh"

if [[ -f "${HOME}/.config/dev-setup/env.sh" ]]; then
  source "${HOME}/.config/dev-setup/env.sh"
fi

if [[ -f "${HOME}/.secrets" ]]; then
  set -a
  source "${HOME}/.secrets"
  set +a
fi
# Rokit (Roblox toolchain manager), installed by install/rokit.sh. Keep this exact
# path: Rokit's self-install looks for it and appends a line if it is missing.
[ -f "$HOME/.rokit/env" ] && . "$HOME/.rokit/env"
