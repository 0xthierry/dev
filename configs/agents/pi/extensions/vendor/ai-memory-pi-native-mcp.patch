+    throw new Error("ai-memory remote capture requires an HTTPS Tailscale origin");
+  if (url.origin !== REMOTE_ORIGIN) throw new Error("ai-memory remote capture requires the configured deployment origin");
+  return REMOTE_ORIGIN;
