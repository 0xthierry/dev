{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/0xthierry/dev/main/configs/agents/pi/extensions/blueprint/schema.json",
  "title": "Pi Blueprint",
  "description": "JSONC blueprint graph for the Pi /blueprint extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "nodes"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema URI for editor IntelliSense."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Blueprint name. The command exposes it as scope/name and, when unique, as name."
    },
    "description": {
      "type": "string",
      "description": "Human-readable summary shown in /blueprint list and completions."
    },
    "start": {
      "type": "string",
      "minLength": 1,
      "description": "Node id to start from. Defaults to the first node when omitted."
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/node" },
      "description": "Graph nodes keyed by node id."
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        { "$ref": "#/$defs/piNode" },
        { "$ref": "#/$defs/commandNode" },
        { "$ref": "#/$defs/stopNode" }
      ]
    },
    "nodeBase": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["pi", "command", "stop"]
        },
        "description": {
          "type": "string"
        },
        "next": {
          "type": "string",
          "minLength": 1,
          "description": "Default next node after a successful non-stop node."
        },
        "on": {
          "$ref": "#/$defs/edges"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum number of executions for this node in loops."
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "success": {
          "type": "string",
          "minLength": 1
        },
        "failure": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "piNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "anyOf": [{ "required": ["prompt"] }, { "required": ["promptFile"] }],
      "properties": {
        "type": { "const": "pi" },
        "description": { "type": "string" },
        "next": { "type": "string", "minLength": 1 },
        "on": { "$ref": "#/$defs/edges" },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "prompt": {
          "type": "string",
          "description": "Prompt text. Supports {{input.task}}, {{context.file}}, {{context.content}}, and {{nodes.<id>.*}} templates."
        },
        "promptFile": {
          "type": "string",
          "description": "Path to a prompt file, relative to the blueprint file directory unless absolute or ~/ prefixed."
        },
        "systemPrompt": {
          "type": "string"
        },
        "systemPromptFile": {
          "type": "string",
          "description": "Path to a system prompt file, relative to the blueprint file directory unless absolute or ~/ prefixed."
        },
        "tools": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Comma allowlist passed to child pi --tools, for example read, bash, edit, write."
        },
        "skills": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Skill file or directory paths passed to child pi --skill. Relative paths resolve from the blueprint file directory."
        },
        "model": {
          "type": "string",
          "description": "Child model, provider/model, or inherit."
        },
        "thinking": {
          "enum": ["off", "minimal", "low", "medium", "high", "xhigh"]
        }
      }
    },
    "commandNode": {
      "allOf": [{ "$ref": "#/$defs/nodeBase" }],
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "run"],
      "properties": {
        "type": { "const": "command" },
        "description": { "type": "string" },
        "next": { "type": "string", "minLength": 1 },
        "on": { "$ref": "#/$defs/edges" },
        "maxAttempts": { "type": "integer", "minimum": 1 },
        "run": {
          "type": "string",
          "minLength": 1,
          "description": "Shell command run in the current checkout. Supports blueprint templates."
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stopNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "stop" },
        "description": { "type": "string" },
        "message": {
          "type": "string",
          "description": "Completion message for the blueprint run."
        },
        "maxAttempts": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
