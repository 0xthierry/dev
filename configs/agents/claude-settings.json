{
  "env": {
    "DISABLE_COST_WARNINGS": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "50000",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoMemoryEnabled": false,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git worktree:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(wc:*)",
      "Bash(mktemp:*)",
      "Bash(bun build:*)",
      "Bash(linear:*)",
      "Bash(agent-slack:*)",
      "Bash(agent-browser:*)",
      "Bash(npx agent-browser:*)",
      "Bash(ghidra:*)",
      "Bash(ilspy:*)",
      "Bash(codex exec:*)",
      "Bash(claude:*)",
      "Bash(~/.agents/bin/*:*)",
      "Bash(bash ~/.agents/bin/*:*)",
      "Bash(bun ~/.agents/hooks/*:*)",
      "Read(~/.agents/**)"
    ],
    "deny": [
      "AskUserQuestion",
      "Artifact",
      "RemoteTrigger",
      "EnterPlanMode",
      "ExitPlanMode",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --force *)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(brew install *)",
      "Bash(brew reinstall *)",
      "Bash(pacman -S*)",
      "Bash(sudo pacman -S*)",
      "Bash(yay -S*)",
      "Bash(sudo yay -S*)",
      "NotebookEdit",
      "EnterWorktree",
      "ExitWorktree",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Google_Drive__*"
    ],
    "defaultMode": "default"
  },
  "model": "claude-fable-5-1",
  "enableAllProjectMcpServers": false,
  "statusLine": {
    "type": "command",
    "command": "mise exec -- bun ~/.agents/statusline.ts",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true
}
