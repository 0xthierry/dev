{
  "env": {
    "MAX_THINKING_TOKENS": "32199",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_COST_WARNINGS": "1",
    "USE_BUILTIN_RIPGREP": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0",
    "DISABLE_TELEMETRY": "0",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "50000",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-4-5-20251001",
    "ENABLE_LSP_TOOL": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git worktree:*)",
      "Bash(gh repo view:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(ls:*)",
      "Bash(cp:*)",
      "Bash(wc:*)",
      "Bash(mktemp:*)",
      "Bash(bun build:*)",
      "Bash(linear:*)",
      "Bash(agent-slack:*)",
      "Bash(agent-browser:*)",
      "Bash(npx agent-browser:*)",
      "Bash(ghidra:*)",
      "Bash(ilspy:*)",
      "Bash(codex exec:*)",
      "Bash(claude:*)",
      "Bash(~/.agents/bin/*:*)",
      "Bash(bash ~/.agents/bin/*:*)",
      "Bash(bun ~/.agents/hooks/*:*)",
      "Write(ai_docs/**)",
      "Edit(ai_docs/**)",
      "Write(~/.claude/projects/**)",
      "Write(~/.codex/projects/**)",
      "Write(~/.claude/ai_docs/**)",
      "Write(~/.claude/skills/**)",
      "Write(~/.codex/skills/**)",
      "Write(~/.agents/skills/**)",
      "Read(~/.agents/**)"
    ],
    "deny": [
      "AskUserQuestion",
      "EnterPlanMode",
      "ExitPlanMode",
      "SlashCommand",
      "TaskOutput",
      "TaskCreate",
      "TaskList",
      "TaskGet",
      "TaskUpdate",
      "TaskStop",
      "TodoWrite",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(rm -f -r *)",
      "Bash(rm --force *)",
      "Bash(git reset --hard*)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(brew install *)",
      "Bash(brew reinstall *)",
      "Bash(pacman -S*)",
      "Bash(sudo pacman -S*)",
      "Bash(yay -S*)",
      "Bash(sudo yay -S*)",
      "NotebookEdit",
      "EnterWorktree",
      "ExitWorktree",
      "CronCreate",
      "CronList",
      "CronDelete",
      "ScheduleWakeup",
      "mcp__claude_ai_Gmail__*",
      "mcp__claude_ai_Google_Calendar__*",
      "mcp__claude_ai_Google_Drive__*"
    ],
    "defaultMode": "default"
  },
  "model": "opus[1m]",
  "enableAllProjectMcpServers": false,
  "statusLine": {
    "type": "command",
    "command": "mise exec -- bun ~/.agents/statusline.ts",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true
}
