{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "transport": "sse",
  "defaultThinkingLevel": "xhigh",
  "theme": "dark",
  "hideThinkingBlock": false,
  "quietStartup": false,
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "shellPath": "/bin/zsh",
  "shellCommandPrefix": "source ~/.zshenv",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "compaction": {
    "enabled": false
  },
  "extensions": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ],
  "skills": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ],
  "prompts": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ],
  "themes": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ]
}
