{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "transport": "auto",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "hideThinkingBlock": false,
  "quietStartup": false,
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "shellPath": "/bin/zsh",
  "shellCommandPrefix": "source ~/.zshenv",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "compaction": {
    "enabled": true
  },
  "packages": [
    "npm:@plannotator/pi-extension@0.22.0"
  ],
  "extensions": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ],
  "skills": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ],
  "prompts": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ],
  "themes": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ]
}
