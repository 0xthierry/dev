{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "transport": "auto",
  "defaultThinkingLevel": "xhigh",
  "theme": "dark",
  "tuiMode": "fullscreen",
  "hideThinkingBlock": false,
  "showCacheMissNotices": true,
  "quietStartup": false,
  "defaultProjectTrust": "always",
  "enableInstallTelemetry": false,
  "enableSkillCommands": true,
  "shellPath": "/bin/zsh",
  "shellCommandPrefix": "source ~/.zshenv",
  "warnings": {
    "anthropicExtraUsage": true
  },
  "compaction": {
    "enabled": true
  },
  "packages": [
    "npm:@plannotator/pi-extension@0.24.2"
  ],
  "extensions": [
    "-extensions/codex-fast-mode",
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ],
  "skills": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ],
  "prompts": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ],
  "themes": [
    "!../../.agents/**",
    "!../../.claude/**",
    "!../../.codex/**"
  ]
}
