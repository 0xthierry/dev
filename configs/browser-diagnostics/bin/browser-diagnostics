#!/bin/sh
set -eu

SOURCE=$0
while [ -L "$SOURCE" ]; do
  SOURCE_DIR=$(CDPATH='' cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)
  LINK=$(readlink "$SOURCE")
  case $LINK in
    /*) SOURCE=$LINK ;;
    *) SOURCE=$SOURCE_DIR/$LINK ;;
  esac
done
BIN_DIR=$(CDPATH='' cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)
PACKAGE_DIR=$(CDPATH='' cd -P "$BIN_DIR/.." >/dev/null 2>&1 && pwd)
exec bun "$PACKAGE_DIR/src/cli.ts" "$@"
