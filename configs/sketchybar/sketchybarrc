#!/bin/bash

# Nord palette
NORD0="0xff2e3440"
NORD1="0xff3b4252"
NORD2="0xff434c5e"
NORD3="0xff4c566a"
NORD4="0xffd8dee9"
NORD5="0xffe5e9f0"
NORD6="0xffeceff4"
NORD7="0xff8fbcbb"
NORD8="0xff88c0d0"
NORD9="0xff81a1c1"
NORD10="0xff5e81ac"
NORD11="0xffbf616a"
NORD12="0xffd08770"
NORD13="0xffebcb8b"
NORD14="0xffa3be8c"
NORD15="0xffb48ead"

FONT="SF Pro:Bold:13.0"
ICON_FONT="SF Pro:Bold:15.0"
PADDINGS=4

# Bar
sketchybar --bar \
  height=32 \
  color="$NORD0" \
  border_width=0 \
  shadow=off \
  position=top \
  sticky=on \
  padding_right=10 \
  padding_left=10 \
  topmost=window \
  font_smoothing=on \
  y_offset=0 \
  margin=0 \
  corner_radius=0

# Defaults
sketchybar --default \
  icon.font="$ICON_FONT" \
  icon.color="$NORD4" \
  icon.padding_left="$PADDINGS" \
  icon.padding_right=2 \
  label.font="$FONT" \
  label.color="$NORD4" \
  label.padding_left=2 \
  label.padding_right="$PADDINGS" \
  padding_right=3 \
  padding_left=3 \
  background.height=24 \
  background.corner_radius=6

# ==========================================
# Left: AeroSpace workspaces
# ==========================================

for i in $(seq 1 10); do
  sketchybar --add item space."$i" left \
    --subscribe space."$i" aerospace_workspace_change \
    --set space."$i" \
      background.color="$NORD2" \
      background.corner_radius=6 \
      background.height=22 \
      background.drawing=off \
      label="$i" \
      label.font="$FONT" \
      label.color="$NORD3" \
      click_script="aerospace workspace $i" \
      script="$CONFIG_DIR/plugins/aerospace.sh $i"
done

# Separator
sketchybar --add item sep.left left \
  --set sep.left \
    icon="│" \
    icon.color="$NORD2" \
    icon.font="$ICON_FONT" \
    icon.padding_left=4 \
    icon.padding_right=4 \
    label.drawing=off \
    background.drawing=off

# ==========================================
# Center: focused app
# ==========================================

sketchybar --add item front_app center \
  --subscribe front_app front_app_switched \
  --set front_app \
    icon.drawing=off \
    label.font="$FONT" \
    label.color="$NORD8" \
    script="$CONFIG_DIR/plugins/front_app.sh"

# ==========================================
# Right side (ordered right-to-left)
# ==========================================

# Clock
sketchybar --add item clock right \
  --set clock \
    update_freq=30 \
    icon="󰥔" \
    icon.color="$NORD9" \
    label.font="$FONT" \
    label.color="$NORD4" \
    script="$CONFIG_DIR/plugins/clock.sh"

# Separator
sketchybar --add item sep.r1 right \
  --set sep.r1 icon="│" icon.color="$NORD2" icon.font="$ICON_FONT" \
    icon.padding_left=2 icon.padding_right=2 label.drawing=off background.drawing=off

# Battery (hover for details)
sketchybar --add item battery right \
  --subscribe battery system_woke power_source_change mouse.entered mouse.exited \
  --set battery \
    update_freq=60 \
    icon.color="$NORD14" \
    label.font="$FONT" \
    label.color="$NORD4" \
    popup.background.color="$NORD1" \
    popup.background.corner_radius=8 \
    popup.background.border_color="$NORD3" \
    popup.background.border_width=1 \
    script="$CONFIG_DIR/plugins/battery.sh"

sketchybar --add item battery.details popup.battery \
  --set battery.details \
    icon.drawing=off \
    label.font="$FONT" \
    label.color="$NORD4" \
    background.drawing=off

# Separator
sketchybar --add item sep.r2 right \
  --set sep.r2 icon="│" icon.color="$NORD2" icon.font="$ICON_FONT" \
    icon.padding_left=2 icon.padding_right=2 label.drawing=off background.drawing=off

# Volume
sketchybar --add item volume right \
  --subscribe volume volume_change \
  --set volume \
    icon.color="$NORD15" \
    label.font="$FONT" \
    label.color="$NORD4" \
    script="$CONFIG_DIR/plugins/volume.sh"

# Separator
sketchybar --add item sep.r3 right \
  --set sep.r3 icon="│" icon.color="$NORD2" icon.font="$ICON_FONT" \
    icon.padding_left=2 icon.padding_right=2 label.drawing=off background.drawing=off

# Wi-Fi
sketchybar --add item wifi right \
  --subscribe wifi wifi_change \
  --set wifi \
    update_freq=30 \
    icon.color="$NORD7" \
    label.font="$FONT" \
    label.color="$NORD4" \
    click_script="open 'x-apple.systempreferences:com.apple.preference.network'" \
    script="$CONFIG_DIR/plugins/wifi.sh"

# Separator
sketchybar --add item sep.r4 right \
  --set sep.r4 icon="│" icon.color="$NORD2" icon.font="$ICON_FONT" \
    icon.padding_left=2 icon.padding_right=2 label.drawing=off background.drawing=off

# Bluetooth
sketchybar --add item bluetooth right \
  --subscribe bluetooth bluetooth_change \
  --set bluetooth \
    update_freq=60 \
    icon.color="$NORD9" \
    label.font="$FONT" \
    label.color="$NORD4" \
    click_script="open 'x-apple.systempreferences:com.apple.preference.bluetooth'" \
    script="$CONFIG_DIR/plugins/bluetooth.sh"

# Separator
sketchybar --add item sep.r5 right \
  --set sep.r5 icon="│" icon.color="$NORD2" icon.font="$ICON_FONT" \
    icon.padding_left=2 icon.padding_right=2 label.drawing=off background.drawing=off

# CPU + RAM (click to open btop)
sketchybar --add item cpu right \
  --set cpu \
    update_freq=5 \
    icon="󰘚" \
    icon.color="$NORD12" \
    label.font="$FONT" \
    label.color="$NORD4" \
    click_script="open -a Ghostty --args -e btop" \
    script="$CONFIG_DIR/plugins/cpu.sh"

# Separator
sketchybar --add item sep.r6 right \
  --set sep.r6 icon="│" icon.color="$NORD2" icon.font="$ICON_FONT" \
    icon.padding_left=2 icon.padding_right=2 label.drawing=off background.drawing=off

# Media (now playing)
sketchybar --add item media right \
  --subscribe media media_change \
  --set media \
    icon="󰎆" \
    icon.color="$NORD14" \
    label.font="$FONT" \
    label.color="$NORD4" \
    label.max_chars=30 \
    scroll_texts=on \
    script="$CONFIG_DIR/plugins/media.sh"

# Separator
sketchybar --add item sep.r7 right \
  --set sep.r7 icon="│" icon.color="$NORD2" icon.font="$ICON_FONT" \
    icon.padding_left=2 icon.padding_right=2 label.drawing=off background.drawing=off

# Mic
sketchybar --add item mic right \
  --set mic \
    update_freq=3 \
    icon.color="$NORD11" \
    label.drawing=off \
    click_script="$CONFIG_DIR/plugins/mic_click.sh" \
    script="$CONFIG_DIR/plugins/mic.sh"

# Finalize
sketchybar --update
