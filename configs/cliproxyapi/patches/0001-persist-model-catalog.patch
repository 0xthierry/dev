+const cachedModels = `{"claude":[{"id":"cache-fixture","native_capabilities":{"web_search":true}}],"meta":[{"id":"old-meta","native_capabilities":{"web_search":true},"future_field":42}]}`
+
+func isolateOfficialCache(t *testing.T) (string, *catalogUpdater) {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "private", "models.json")
+	t.Setenv("CLIPROXYAPI_MODEL_CACHE", path)
+	oldModels := getModels()
+	oldURLs := modelsURLs
+	refreshCallbackMu.Lock()
+	oldCb, oldPending := refreshCallback, pendingRefreshChanges
+	refreshCallback, pendingRefreshChanges = nil, nil
+	refreshCallbackMu.Unlock()
+	t.Cleanup(func() {
+		modelsURLs = oldURLs
+		modelsCatalogStore.mu.Lock()
+		modelsCatalogStore.data = oldModels
+		modelsCatalogStore.mu.Unlock()
+		refreshCallbackMu.Lock()
+		refreshCallback, pendingRefreshChanges = oldCb, oldPending
+		refreshCallbackMu.Unlock()
+	})
+	return path, &catalogUpdater{cache: &officialCatalogCache{}, publish: publishCatalogBytes, fetchWithSource: catalogFetcherWithSource(embeddedModelsJSON, nil, validateCatalogBytes)}
+}
