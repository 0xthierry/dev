+func TestOfficialCacheRetrySchedule(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		ctx, cancel := context.WithCancel(context.Background())
+		defer cancel()
+		var at []time.Time
+		runOfficialCatalogRefresh(ctx, func() bool {
+			at = append(at, time.Now())
+			n := len(at)
+			if n == 9 {
+				cancel()
+			}
+			return n == 7
+		})
+		if len(at) != 9 {
+			t.Fatalf("attempts=%d", len(at))
+		}
+		for i, window := range []time.Duration{5 * time.Second, 10 * time.Second, 20 * time.Second, 40 * time.Second, time.Minute, time.Minute, 3 * time.Hour, 5 * time.Second} {
+			got := at[i+1].Sub(at[i])
+			lower := window / 2
+			if i == 6 {
+				lower = window
+			}
+			if got < lower || got > window {
+				t.Fatalf("interval %d=%s outside [%s,%s]", i, got, lower, window)
+			}
+		}
+	})
+}
