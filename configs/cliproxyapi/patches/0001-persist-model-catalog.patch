+func TestModelsUpdaterCancellationStopsRetry(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	var calls atomic.Int32
+	done := make(chan struct{})
+	go func() {
+		runModelsUpdaterSchedule(ctx, func(context.Context) bool {
+			calls.Add(1)
+			cancel()
+			return false
+		}, time.Millisecond, time.Hour, func() float64 { return 0 })
+		close(done)
+	}()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("cancellation did not stop updater")
+	}
+	if got := calls.Load(); got != 1 {
+		t.Fatalf("canceled updater fetched %d times, want 1", got)
+	}
+}
