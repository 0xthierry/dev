+			close(started)
+			<-release
+			_, _ = w.Write([]byte(`{"claude":[{"id":"stale"}]}`))
+			return
+		}
+		_, _ = w.Write([]byte(cachedModels))
+	}))
+	defer server.Close()
+	modelsURLs = []string{server.URL}
+	done := make(chan bool, 1)
+	go func() { done <- u.refresh(context.Background(), "", 0) }()
+	<-started
+	result, err := u.refreshOnDemand(context.Background(), "", modelsURLs)
+	close(release)
+	<-done
+	if err == nil || result.Error == "" || !slices.Contains(result.ChangedProviders, "claude") || LookupStaticModelInfo("cache-fixture") == nil || LookupStaticModelInfo("stale") != nil {
+		t.Fatalf("undurable publication or fence incorrect: %+v, %v", result, err)
+	}
+	entries, err := os.ReadDir(filepath.Dir(path))
+	if err != nil || len(entries) != 1 || !entries[0].IsDir() || entries[0].Name() != "models.json" {
+		t.Fatalf("failed replace damaged destination: %v %v", entries, err)
+	}
+	if err := os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	if !u.refresh(context.Background(), "", 0) {
+		t.Fatal("retry failed")
+	}
+	raw, err := os.ReadFile(path)
+	if err != nil || string(raw) != cachedModels {
+		t.Fatalf("retry did not persist original bytes: %v", err)
+	}
+}
+
+func TestOfficialCacheBypassedForOtherPolicies(t *testing.T) {
+	for _, name := range []string{"custom-file", "custom-http", "local", "home"} {
+		t.Run(name, func(t *testing.T) {
+			path, u := isolateOfficialCache(t)
+			if err := persistModelsCache(path, []byte(cachedModels)); err != nil {
+				t.Fatal(err)
+			}
+			const raw = `{"claude":[{"id":"custom-only"}]}`
+			var sources CatalogSources
+			switch name {
+			case "custom-file":
+				sources.Catalog = filepath.Join(t.TempDir(), "custom.json")
+				if err := os.WriteFile(sources.Catalog, []byte(raw), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "custom-http":
+				server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { _, _ = w.Write([]byte(raw)) }))
+				defer server.Close()
+				sources.Catalog = server.URL
+			}
+			source := effectiveCatalogSources(sources, name == "local", name == "home").Catalog
+			ctx, cancel := context.WithCancel(context.Background())
+			cancel()
+			u.configure(ctx, source)
+			status, err := u.refreshOnDemand(context.Background(), source, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if name == "local" || name == "home" {
+				if !status.Skipped {
+					t.Fatalf("policy did not skip refresh: %+v", status)
+				}
+			} else if !status.Refreshed || LookupStaticModelInfo("custom-only") == nil {
+				t.Fatalf("custom source not used: %+v", status)
+			}
+			got, err := os.ReadFile(path)
+			if err != nil || string(got) != cachedModels || LookupStaticModelInfo("cache-fixture") != nil {
+				t.Fatalf("policy used or overwrote official cache: %v", err)
+			}
+		})
+	}
+}
