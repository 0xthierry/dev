+	if info.Mode().Perm() != 0600 {
+		t.Fatalf("cache permissions = %o, want 0600", info.Mode().Perm())
+	}
+	entries, err := os.ReadDir(filepath.Dir(path))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(entries) != 1 || entries[0].Name() != "models.json" {
+		t.Fatalf("atomic write left temporary files: %v", entries)
+	}
+	if err := loadModelsFromBytes(embeddedModelsJSON, "embed"); err != nil {
+		t.Fatal(err)
+	}
+	if err := restoreModelsCache(path); err != nil || !hasOpus55() {
+		t.Fatalf("persisted model did not survive simulated restart: %v", err)
+	}
+}
