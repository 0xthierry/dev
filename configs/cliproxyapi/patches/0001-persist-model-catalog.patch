+func TestModelsUpdaterRetriesAndResetsAfterRecovery(t *testing.T) {
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	attempts := make(chan time.Time, 4)
+	var count atomic.Int32
+	done := make(chan struct{})
+	go func() {
+		runModelsUpdaterSchedule(ctx, func(context.Context) bool {
+			attempts <- time.Now()
+			return count.Add(1) >= 3
+		}, 30*time.Millisecond, 400*time.Millisecond, func() float64 { return 1 })
+		close(done)
+	}()
+	times := make([]time.Time, 0, 4)
+	for i := 0; i < 4; i++ {
+		select {
+		case at := <-attempts:
+			times = append(times, at)
+		case <-time.After(2 * time.Second):
+			t.Fatal("updater did not retry or resume normal schedule")
+		}
+	}
+	cancel()
+	<-done
+	if elapsed := times[1].Sub(times[0]); elapsed < 20*time.Millisecond || elapsed > 250*time.Millisecond {
+		t.Fatalf("first retry interval = %v", elapsed)
+	}
+	if elapsed := times[2].Sub(times[1]); elapsed < 45*time.Millisecond || elapsed > 250*time.Millisecond {
+		t.Fatalf("second retry interval = %v", elapsed)
+	}
+	if elapsed := times[3].Sub(times[2]); elapsed < 350*time.Millisecond {
+		t.Fatalf("success failed to restore normal schedule: %v", elapsed)
+	}
+}
