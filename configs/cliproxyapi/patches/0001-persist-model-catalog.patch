+		t.Fatal(err)
+	}
+	old := generalCatalogUpdater
+	generalCatalogUpdater = u
+	defer func() { generalCatalogUpdater = old }()
+	var notified []string
+	SetModelRefreshCallback(func(changed []string) { notified = changed })
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel() // no network
+	StartModelsUpdater(ctx)
+	m := LookupStaticModelInfo("cache-fixture")
+	if !slices.Contains(notified, "claude") || m == nil || m.NativeCapabilities == nil || m.NativeCapabilities.WebSearch == nil || !*m.NativeCapabilities.WebSearch {
+		t.Fatalf("restored model=%+v callback=%v", m, notified)
+	}
+}
+
+func TestOfficialCacheAvailableBeforeOfflineFetch(t *testing.T) {
+	path, u := isolateOfficialCache(t)
+	if err := persistModelsCache(path, []byte(cachedModels)); err != nil {
+		t.Fatal(err)
+	}
+	seen := make(chan bool, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		seen <- LookupStaticModelInfo("cache-fixture") != nil
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer server.Close()
+	modelsURLs = []string{server.URL}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	u.configure(ctx, "")
+	select {
+	case ready := <-seen:
+		if !ready {
+			t.Fatal("official fetch began before cache restoration")
+		}
+	case <-time.After(3 * time.Second):
+		t.Fatal("no startup fetch")
+	}
+	cancel()
+	got, err := os.ReadFile(path)
+	if err != nil || string(got) != cachedModels || LookupStaticModelInfo("cache-fixture") == nil {
+		t.Fatalf("offline refresh displaced cache: %v", err)
+	}
+}
