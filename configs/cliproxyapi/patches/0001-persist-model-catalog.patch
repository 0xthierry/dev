+func TestModelsCacheSurvivesOfflineRefreshAndNotifies(t *testing.T) {
+	isolateModelsUpdater(t)
+	path := filepath.Join(t.TempDir(), "models.json")
+	t.Setenv("CLIPROXYAPI_MODEL_CACHE", path)
+	if err := persistModelsCache(path, catalogWithOpus55(t)); err != nil {
+		t.Fatal(err)
+	}
+	seen := make(chan bool, 1)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		seen <- hasOpus55()
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer server.Close()
+	modelsURLs = []string{server.URL}
+	var notified []string
+	SetModelRefreshCallback(func(providers []string) { notified = append(notified, providers...) })
+
+	if err := restoreModelsCache(path); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	done := make(chan struct{})
+	go func() { runModelsUpdater(ctx); close(done) }()
+	select {
+	case loaded := <-seen:
+		if !loaded {
+			t.Error("remote fetch began before the cached Opus model was registered")
+		}
+	case <-time.After(3 * time.Second):
+		t.Error("startup fetch was not attempted")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(3 * time.Second):
+		t.Fatal("updater failed to stop after cancellation")
+	}
+	if !hasOpus55() {
+		t.Fatal("offline startup replaced cached Opus model")
+	}
+	if !containsProvider(notified, "claude") {
+		t.Fatalf("cache restoration did not notify Claude registration: %v", notified)
+	}
+}
+
+// A canceled context keeps network work out of this test: startup still must
+// synchronously restore and notify before the public call returns.
+func TestStartModelsUpdaterWaitsForCacheRegistration(t *testing.T) {
+	isolateModelsUpdater(t)
+	path := filepath.Join(t.TempDir(), "models.json")
+	t.Setenv("CLIPROXYAPI_MODEL_CACHE", path)
+	if err := persistModelsCache(path, catalogWithOpus55(t)); err != nil {
+		t.Fatal(err)
+	}
+	updaterOnce = sync.Once{}
+	t.Cleanup(func() { updaterOnce = sync.Once{} })
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	SetModelRefreshCallback(func(providers []string) {
+		if containsProvider(providers, "claude") {
+			close(entered)
+			<-release
+		}
+	})
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	returned := make(chan struct{})
+	go func() { StartModelsUpdater(ctx); close(returned) }()
+	select {
+	case <-entered:
+	case <-time.After(3 * time.Second):
+		close(release)
+		t.Fatal("startup did not notify cached Claude registration")
+	}
+	select {
+	case <-returned:
+		close(release)
+		t.Fatal("StartModelsUpdater returned before cached registration finished")
+	case <-time.After(30 * time.Millisecond):
+	}
+	close(release)
+	select {
+	case <-returned:
+	case <-time.After(3 * time.Second):
+		t.Fatal("StartModelsUpdater did not return after registration")
+	}
+	if !hasOpus55() {
+		t.Fatal("StartModelsUpdater returned without cached Opus model")
+	}
+}
+
+func containsProvider(providers []string, want string) bool {
+	for _, provider := range providers {
+		if provider == want {
+			return true
+		}
+	}
+	return false
+}
