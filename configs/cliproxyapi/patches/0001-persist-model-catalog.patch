diff --git i/internal/registry/official_catalog_cache.go w/internal/registry/official_catalog_cache.go
new file mode 100644
index 0000000..c93a231
--- /dev/null
+++ w/internal/registry/official_catalog_cache.go
@@ -0,0 +1,180 @@
+package registry
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"math/rand/v2"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/MoeForge/moego/json"
+	"github.com/MoeForge/moego/ojson"
+)
+
+// meta is taken only from an official catalog, never from a custom source.
+// Access is serialized by catalogUpdater.mu together with publication.
+type officialCatalogCache struct {
+	meta        string
+	initialized bool
+}
+
+func decodeOfficialCatalog(raw []byte) (*staticModelsJSON, error) {
+	var parsed staticModelsJSON
+	if err := json.Unmarshal(raw, &parsed); err != nil {
+		return nil, err
+	}
+	if len(parsed.Claude)+len(parsed.Gemini)+len(parsed.Vertex)+len(parsed.AIStudio)+len(parsed.CodexFree)+len(parsed.CodexTeam)+len(parsed.CodexPlus)+len(parsed.CodexPro)+len(parsed.Copilot)+len(parsed.Kimi)+len(parsed.Antigravity)+len(parsed.XAI)+len(parsed.Devin)+len(parsed.Meta) == 0 {
+		return nil, fmt.Errorf("catalog contains no models")
+	}
+	if err := validateModelsCatalog(&parsed); err != nil {
+		return nil, err
+	}
+	if len(parsed.Devin) > 0 {
+		if err := validateModelSection("devin", parsed.Devin); err != nil {
+			return nil, err
+		}
+	}
+	return &parsed, nil
+}
+
+func fetchOfficialCatalog(ctx context.Context) ([]byte, string, error) {
+	var first string
+	for i, url := range modelsURLs {
+		if i == 0 {
+			first = url
+		}
+		if ctx.Err() != nil {
+			break
+		}
+		attempt, cancel := context.WithTimeout(ctx, 30*time.Second)
+		raw, err := readCatalogSource(attempt, url)
+		cancel()
+		if err == nil {
+			if _, err = decodeOfficialCatalog(raw); err == nil {
+				return raw, url, nil
+			}
+		}
+	}
+	return nil, first, fmt.Errorf("no valid model catalog source")
+}
+
+func (c *officialCatalogCache) apply(raw []byte, preserveMeta bool) ([]string, []byte, error) {
+	parsed, err := decodeOfficialCatalog(raw)
+	if err != nil {
+		return nil, nil, err
+	}
+	if preserveMeta && len(parsed.Meta) == 0 {
+		previous := c.meta
+		if !c.initialized {
+			previous = ojson.GetBytes(embeddedModelsJSON, "meta").Raw
+		}
+		if previous != "" {
+			doc := ojson.NewDoc(raw)
+			if err := doc.SetRaw("meta", previous); err != nil {
+				return nil, nil, err
+			}
+			raw = doc.Bytes()
+			if len(raw) > maxCodexClientModelsSize {
+				return nil, nil, fmt.Errorf("merged catalog exceeds size limit")
+			}
+			parsed, err = decodeOfficialCatalog(raw)
+			if err != nil {
+				return nil, nil, err
+			}
+		}
+	}
+	c.meta = ""
+	if len(parsed.Meta) > 0 {
+		c.meta = ojson.GetBytes(raw, "meta").Raw
+	}
+	c.initialized = true
+	modelsCatalogStore.mu.Lock()
+	old := modelsCatalogStore.data
+	modelsCatalogStore.data = parsed
+	modelsCatalogStore.mu.Unlock()
+	return detectChangedProviders(old, parsed), raw, nil
+}
+
+func modelCachePath() string {
+	if path := os.Getenv("CLIPROXYAPI_MODEL_CACHE"); path != "" {
+		return path
+	}
+	dir, err := os.UserCacheDir()
+	if err != nil {
+		return ""
+	}
+	return filepath.Join(dir, "cliproxyapi", "models.json")
+}
+
+func (c *officialCatalogCache) restore(path string) ([]string, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	raw, err := io.ReadAll(io.LimitReader(f, maxCodexClientModelsSize+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(raw) > maxCodexClientModelsSize {
+		return nil, fmt.Errorf("model cache exceeds size limit")
+	}
+	changed, _, err := c.apply(raw, false)
+	return changed, err
+}
+
+func persistModelsCache(path string, data []byte) error {
+	if path == "" {
+		return fmt.Errorf("no model cache directory available")
+	}
+	dir := filepath.Dir(path)
+	if err := os.MkdirAll(dir, 0700); err != nil {
+		return err
+	}
+	file, err := os.CreateTemp(dir, ".models-*.tmp")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(file.Name())
+	if _, err = file.Write(data); err == nil {
+		err = file.Sync()
+	}
+	if errClose := file.Close(); err == nil {
+		err = errClose
+	}
+	if err != nil {
+		return err
+	}
+	if err = os.Rename(file.Name(), path); err != nil {
+		return err
+	}
+	parent, err := os.Open(dir)
+	if err != nil {
+		return err
+	}
+	defer parent.Close()
+	return parent.Sync()
+}
+
+func runOfficialCatalogRefresh(ctx context.Context, refresh func() bool) {
+	const base = 5 * time.Second
+	backoff := base
+	for ctx.Err() == nil {
+		delay := ModelsRefreshInterval
+		if refresh() {
+			backoff = base
+		} else {
+			delay = backoff/2 + time.Duration(rand.Int64N(int64(backoff/2)+1))
+			backoff = min(backoff*2, time.Minute)
+		}
+		timer := time.NewTimer(delay)
+		select {
+		case <-ctx.Done():
+			timer.Stop()
+			return
+		case <-timer.C:
+		}
+	}
+}
