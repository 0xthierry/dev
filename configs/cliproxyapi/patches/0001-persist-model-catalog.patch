+// Half-width jitter prevents a fleet of offline instances from retrying in
+// lockstep; delays stay between half and all of the capped exponential.
+func modelsRetryDelay(failures int, base time.Duration, jitter float64) time.Duration {
+	capDelay := base
+	for i := 1; i < failures && capDelay < modelsRetryMax; i++ {
+		if capDelay > modelsRetryMax/2 {
+			capDelay = modelsRetryMax
+		} else {
+			capDelay *= 2
+		}
+	}
+	if capDelay > modelsRetryMax {
+		capDelay = modelsRetryMax
+	}
+	return capDelay/2 + time.Duration(float64(capDelay/2)*jitter)
 }
 
