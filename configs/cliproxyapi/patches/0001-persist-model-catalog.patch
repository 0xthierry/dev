+func isolateModelsUpdater(t *testing.T) {
+	t.Helper()
+	oldURLs := modelsURLs
+	modelsURLs = nil
+	SetModelRefreshCallback(nil)
+	refreshCallbackMu.Lock()
+	pendingRefreshChanges = nil
+	refreshCallbackMu.Unlock()
+	if err := loadModelsFromBytes(embeddedModelsJSON, "embed"); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() {
+		modelsURLs = oldURLs
+		SetModelRefreshCallback(nil)
+		refreshCallbackMu.Lock()
+		pendingRefreshChanges = nil
+		refreshCallbackMu.Unlock()
+		if err := loadModelsFromBytes(embeddedModelsJSON, "embed"); err != nil {
+			t.Errorf("restore embedded catalog: %v", err)
+		}
+	})
+}
+
+func catalogWithOpus55(t *testing.T) []byte {
+	t.Helper()
+	var catalog map[string]json.RawMessage
+	if err := json.Unmarshal(embeddedModelsJSON, &catalog); err != nil {
+		t.Fatal(err)
+	}
+	var claude []json.RawMessage
+	if err := json.Unmarshal(catalog["claude"], &claude); err != nil {
+		t.Fatal(err)
+	}
+	claude = append(claude, json.RawMessage(`{"id":"claude-opus-5-5","native_capabilities":{"web_search":true}}`))
+	var err error
+	catalog["claude"], err = json.Marshal(claude)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data, err := json.Marshal(catalog)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return data
+}
+
+func hasOpus55() bool {
+	for _, model := range GetClaudeModels() {
+		if model.ID == "claude-opus-5-5" {
+			return model.NativeCapabilities != nil && model.NativeCapabilities.WebSearch != nil && *model.NativeCapabilities.WebSearch
+		}
+	}
+	return false
+}
