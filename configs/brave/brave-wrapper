#!/usr/bin/env bash
# Launches Brave with CDP remote debugging enabled on 127.0.0.1:9222 so
# Chrome DevTools MCP and diagnostic clients can attach to the real user session.
# Playwriter uses its browser extension instead of this endpoint.
exec /usr/bin/brave --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1 "$@"
