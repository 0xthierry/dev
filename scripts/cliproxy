#!/usr/bin/env bash
# Local Codex pool for Pi and Claude pool for Claude Code. Secrets stay in private user state.
set +x
set -euo pipefail
umask 077
config="$HOME/.config/cliproxyapi/config.yaml"
key_file="$HOME/.config/cliproxyapi/api-key"
binary="$HOME/.local/bin/cli-proxy-api"
export CLIPROXYAPI_MODEL_CACHE="$HOME/.local/share/cliproxyapi/models.json"

usage() {
  printf '%s\n' 'Usage: cliproxy {login|login-claude|serve|models|check|usage|priority|pi|claude} [arguments...]' \
    '  login    Add/refresh one Codex account using device OAuth; repeat per account' \
    '  login-claude Add/refresh one Claude account using browser OAuth; repeat per account' \
    '  serve    Run the proxy in the foreground' \
    '  models   List model IDs currently available from the account pool' \
    '  check    Verify authentication and report available model count (no inference)' \
    '  usage    Show live Codex and Claude account quotas (--json for structured output)' \
    '  priority List filename/provider/priority; set with <unique filename substring> <integer> (0 reverts)' \
    '  pi       Start Pi using the cliproxyapi provider (arguments passed through)' \
    '  claude   Start Claude Code through the local pool (arguments passed through)'
}

command_name="${1:-help}"
[[ $# == 0 ]] || shift
case "$command_name" in
  help|-h|--help) usage; exit 0 ;;
  login|login-claude|serve|models|check|usage|priority|pi|claude) ;;
  *) usage >&2; exit 2 ;;
esac
# Usage reads OAuth state directly; it works even when the proxy is stopped.
if [[ "$command_name" == usage ]]; then
  if [[ ! -f "$HOME/.local/bin/cliproxy-usage.ts" ]]; then
    printf 'Usage helper missing. Run bash install/cliproxyapi.sh from the setup repo.\n' >&2
    exit 1
  fi
  if ! command -v bun >/dev/null 2>&1; then
    printf 'Bun is required for cliproxy usage; run the repository setup.\n' >&2
    exit 1
  fi
  exec bun "$HOME/.local/bin/cliproxy-usage.ts" "$@"
fi
restart_managed_service() {
  local reason="${1:-refresh per-account model availability}" manual_note="${2:-0}"
  case "$(uname -s)" in
    Linux)
      if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet cliproxyapi.service; then
        systemctl --user restart cliproxyapi.service
        printf 'Restarted the CLIProxyAPI user service to %s.\n' "$reason"
        return 0
      fi
      ;;
    Darwin)
      local service=""
      service="gui/$(id -u)/dev.cliproxyapi"
      if command -v launchctl >/dev/null 2>&1 && launchctl print "$service" >/dev/null 2>&1; then
        launchctl kickstart -k "$service"
        printf 'Restarted the CLIProxyAPI LaunchAgent to %s.\n' "$reason"
        return 0
      fi
      ;;
  esac
  if [[ "$manual_note" == 1 ]]; then
    printf 'No active managed service. Restart any manually running cliproxy serve to load priorities and clear session affinity.\n'
  fi
}

# Priority also reads OAuth state directly, without the proxy key or binary.
if [[ "$command_name" == priority ]]; then
  if [[ ! -f "$HOME/.local/bin/cliproxy-priority.py" ]]; then
    printf 'Priority helper missing. Run bash install/cliproxyapi.sh from the setup repo.\n' >&2
    exit 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    printf 'Python 3 is required for cliproxy priority; run the repository setup.\n' >&2
    exit 1
  fi
  python3 "$HOME/.local/bin/cliproxy-priority.py" "$@"
  if [[ $# == 2 ]]; then
    restart_managed_service 'load account priorities and clear session affinity' 1
  fi
  exit 0
fi
if [[ ! -f "$config" || ! -f "$key_file" || ! -x "$binary" ]]; then
  printf 'CLIProxyAPI is not installed. Run bash install/cliproxyapi.sh from the setup repo.\n' >&2
  exit 1
fi

case "$command_name" in
  login)
    "$binary" --config "$config" --codex-device-login "$@"
    restart_managed_service
    exit 0
    ;;
  login-claude)
    "$binary" --config "$config" --claude-login "$@"
    restart_managed_service
    exit 0
    ;;
  serve) exec "$binary" --config "$config" "$@" ;;
esac
CLIPROXY_API_KEY="$(< "$key_file")"
if [[ ! "$CLIPROXY_API_KEY" =~ ^[0-9a-f]{64}$ ]]; then
  printf 'Invalid local proxy key file; rerun the repository installer.\n' >&2
  exit 1
fi
case "$command_name" in
  pi) exec pi --provider cliproxyapi --model gpt-6.1-sol --thinking high "$@" ;;
  claude)
    # Scope proxy authentication to this child; keep ordinary `claude` direct.
    # Export in the shell, not via `env KEY=value` (which exposes secrets in argv).
    unset ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN_FILE_DESCRIPTOR
    unset CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX CLAUDE_CODE_USE_FOUNDRY
    export ANTHROPIC_BASE_URL="http://127.0.0.1:8317"
    export ANTHROPIC_AUTH_TOKEN="$CLIPROXY_API_KEY"
    exec claude "$@"
    ;;
  models|check)
    # Pass the header via stdin, never expose the key in the process argument list.
    response="$(printf 'header = "Authorization: Bearer %s"\n' "$CLIPROXY_API_KEY" |
      curl --config - --noproxy '*' --fail --silent --show-error --max-time 15 \
        http://127.0.0.1:8317/v1/models)"
    if [[ "$command_name" == models ]]; then
      jq -er '.data | if length == 0 then error("No models: log in to a Codex account first") else .[].id end' <<< "$response"
    else
      jq -er '.data | length | if . == 0 then error("No models: log in to a Codex account first") else "Proxy reachable; \(.) models available. Inference/failover not tested." end' <<< "$response"
    fi
    ;;
esac
