{
  "name": "@0xthierry/dev-pi-extensions",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./configs/agents/pi/extensions/desktop-notification",
      "./configs/agents/pi/extensions/web-access"
    ]
  },
  "scripts": {
    "test:pi-extensions": "bun scripts/pi-extension-tests.ts test",
    "test:pi-extensions:e2e": "bun scripts/pi-extension-tests.ts e2e",
    "lint:pi-extensions": "biome check",
    "typecheck:pi-extensions": "tsc --noEmit -p tsconfig.pi-extensions.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@mariozechner/pi-ai": "^0.71.1",
    "@mariozechner/pi-coding-agent": "^0.71.1",
    "@mariozechner/pi-tui": "^0.71.1",
    "@types/bun": "^1.3.13",
    "typebox": "^1.1.36",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "@types/turndown": "5.0.6",
    "linkedom": "0.18.12",
    "p-limit": "7.3.0",
    "turndown": "7.2.4"
  }
}
