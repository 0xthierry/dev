    "@earendil-works/pi-tui": "0.85.0",
    "@types/bun": "1.3.13",
    "typebox": "1.1.36",
    "typescript": "6.0.3"
  },
  "overrides": {
    "hono": "4.12.34"
  },
  "dependencies": {
    "@ff-labs/fff-node": "0.10.6",
    "@mozilla/readability": "0.6.0",
    "@types/turndown": "5.0.6",
    "codex-multi-auth": "2.12.0",
    "impit": "0.13.1",
    "linkedom": "0.18.12",
    "p-limit": "7.3.0",
    "turndown": "7.2.4",
    "zod": "4.4.3"
  }
