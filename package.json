{
  "name": "@0xthierry/dev-pi-extensions",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./configs/agents/pi/extensions/desktop-notification",
      "./configs/agents/pi/extensions/personality",
      "./configs/agents/pi/extensions/web-access",
      "./configs/agents/pi/extensions/create-image",
      "./configs/agents/pi/extensions/oracle",
      "./configs/agents/pi/extensions/agent-feedback",
      "./configs/agents/pi/extensions/subagent",
      "./configs/agents/pi/extensions/statusline",
      "./configs/agents/pi/extensions/task-title",
      "./configs/agents/pi/extensions/token-speed",
      "./configs/agents/pi/extensions/codex-fast-mode",
      "./configs/agents/pi/extensions/xai-grok-fast-mode",
      "./configs/agents/pi/extensions/codex-compaction",
      "./configs/agents/pi/extensions/codex-multi-auth",
      "./configs/agents/pi/extensions/nested-agents",
      "./configs/agents/pi/extensions/lsp",
      "./configs/agents/pi/extensions/fff",
      "./configs/agents/pi/extensions/amq-notify",
      "./configs/agents/pi/extensions/herdr-agent-state.ts",
      "./configs/agents/pi/extensions/moshi-hooks.ts",
      "./configs/agents/pi/extensions/computer-use"
    ],
    "prompts": [
      "./configs/agents/pi/prompts"
    ]
  },
  "scripts": {
    "pi:usage": "bun scripts/pi-session-usage.ts",
    "codex:usage": "bun scripts/codex-session-usage.ts",
    "test:pi-extensions": "bun scripts/pi-extension-tests.ts test",
    "test:pi-extensions:e2e": "bun scripts/pi-extension-tests.ts e2e",
    "lint:pi-extensions": "biome check",
    "typecheck:pi-extensions": "tsc --noEmit -p tsconfig.pi-extensions.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
